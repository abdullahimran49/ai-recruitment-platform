# Copy to .env and fill in. .env is git-ignored.

# Which backend to use: "groq" (free tier, better model) or "ollama" (local, unlimited)
LLM_PROVIDER=groq

# Groq — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama — local fallback (no key needed)
OLLAMA_MODEL=llama3.1:8b-instruct-q3_K_M

# ---- Email sending (OTP codes, invitations; drafting works without) ----
# EMAIL_MODE=smtp  : classic SMTP (Gmail app password). Some ISPs block SMTP.
# EMAIL_MODE=brevo : Brevo REST API over HTTPS 443 (free 300/day) — use this
#                    if SMTP connections are blocked on your network.
EMAIL_MODE=smtp
FROM_EMAIL=
FROM_NAME=ATS Recruiting

# smtp mode — for Gmail: enable 2FA, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# brevo mode — key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# ---- MySQL + test portal (optional; app works without) ----
# Connection to your local MySQL server (no database name — it's created
# automatically by: python -m core.init_db)
MYSQL_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306
MYSQL_DB=ats_screener

# Secret for signing portal login tokens — set any long random string
JWT_SECRET=

# Where candidates open their test links (the Next.js frontend)
PORTAL_BASE_URL=http://localhost:3000
# CORS origin the FastAPI backend accepts
PORTAL_FRONTEND_ORIGIN=http://localhost:3000
